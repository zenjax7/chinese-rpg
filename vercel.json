{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:ci",
  "outputDirectory": "dist",
  "functions": {
    "api/v1/[...route].ts": { "maxDuration": 10 },
    "api/auth/[...auth].ts": { "maxDuration": 10 }
  },
  "crons": [{ "path": "/api/v1/cron/daily", "schedule": "17 9 * * *" }],
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/v1/[...route]" },
    { "source": "/api/auth/:path*", "destination": "/api/auth/[...auth]" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; form-action 'self' https://accounts.google.com" },
      { "key": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=()" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}

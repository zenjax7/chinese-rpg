   ],
   "lines": [
    {
     "id": "l1",
     "speaker": "narrator",
     "side": "none",
     "expr": "neutral",
     "en": "Little Hill Village. Dawn, and the fields are too quiet.",
     "vo": null
    },
    {
     "id": "l2",
     "speaker": "granny_bai",
     "side": "R1",
     "expr": "worried",
     "en": "{hero}. Come here. The birds did not sing this morning.",
     "vo": null
    },
    {
     "id": "l3",
     "speaker": "granny_bai",
     "side": "R1",
     "expr": "thinking",
     "en": "I have kept this egg since the last war. It was cold for years. Today it is warm again.",
     "vo": null
    },
    {
     "id": "l4",
     "speaker": "hero",
     "side": "L1",
     "expr": "surprised",
     "en": "{C035} is happening?",
     "tokens": [
      "C035"
     ],
     "vo": null
    },
    {
     "id": "l5",
     "speaker": "granny_bai",
     "side": "R1",
     "expr": "worried",
     "en": "A grey fog is on the hills. The creatures are forgetting their words.",
     "vo": null
    },
    {
     "id": "l6",
     "speaker": "granny_bai",
     "side": "R1",
     "expr": "neutral",
     "en": "Talk to Farmer Li in the field, and to Grandpa Wang here in the village. Then meet me at the old well.",
     "vo": null
    },
    {
     "id": "l7",
     "speaker": "hero",
     "side": "L1",
     "expr": "thinking",
     "en": "I'll go. Is the egg safe {C594}?",
     "tokens": [
      "C594"
     ],
     "vo": null
    },
    {
     "id": "l8",
     "speaker": "granny_bai",
     "side": "R1",
     "expr": "neutral",
     "en": "I will wait with it. Go carefully.",
     "vo": null,
     "end": true
    }
   ],
   "onEnd": [
    {
     "setFlag": "met_granny_bai"
    }
   ]
  },

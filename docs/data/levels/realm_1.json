     "en": "If he stays, the village is next. I am too old to walk the road.",
     "vo": null
    },
    {
     "id": "l8",
     "speaker": "hero",
     "side": "L1",
     "expr": "thinking",
     "en": "What do you say to him?",
     "vo": null,
     "choices": [
      {
       "id": "c1",
       "en": "{C001}!",
       "tokens": [
        "C001"
       ],
       "goto": "l9",
       "correct": true,
       "setFlags": [
        "r1_said_hello"
       ]
      },
      {
       "id": "c2",
       "en": "Wave and say nothing.",
       "goto": "l10"
      }
     ]
    },
    {
     "id": "l9",
     "speaker": "xiaolong",
     "side": "R2",
     "expr": "happy",
     "en": "(He spins in a circle and hugs your leg.)",
     "vo": null,
     "goto": "l11"
    },
    {
     "id": "l10",
     "speaker": "xiaolong",
     "side": "R2",
     "expr": "sad",
     "en": "(He tilts his head, waiting... then hugs your leg anyway.)",
     "vo": null
    },
    {
     "id": "l11",
     "speaker": "granny_bai",
     "side": "R1",
     "expr": "happy",
     "en": "When someone is kind, we say {C007}. Take him. Follow the old Bell Road. Ring the Bell before home goes silent.",
     "tokens": [
      "C007"
     ],
     "vo": null
    },
    {
     "id": "l12",
     "speaker": "hero",
     "side": "L1",
     "expr": "happy",
     "en": "Thank you, Granny Bai.",
     "vo": null
    },
    {
     "id": "l13",
     "speaker": "granny_bai",
     "side": "R1",
     "expr": "neutral",
     "en": "His name is 小龙. Little Dragon. The King still wears a fog crown. Off you go.",
     "vo": null,
     "end": true
    }
   ],
   "onEnd": [
    {
     "setFlag": "met_xiaolong"
    },
    {
     "setFlag": "xiaolong_form_hatch"
    },
    {
     "joinParty": "xiaolong"
    }
   ]
  },
  "sc_r1_opening": {
   "schema": "scene/0.2",
   "id": "sc_r1_opening",
   "title": "Too quiet",
   "density": "D1",
   "trigger": {

  "sc_r9_before_demon_king": {
   "schema": "scene/0.2",
   "id": "sc_r9_before_demon_king",
   "title": "The last door",
   "density": "D6",
   "trigger": {
    "graph": "demon_castle_5",
    "node": "boss_9",
    "on": "enter",
    "cond": {
     "all": [
      {
       "flag": "pact_elves"
      },

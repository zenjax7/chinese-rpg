      }
     ]
    }
   },
   "background": "bg_throne_doors",
   "music": "final_resolve",
   "once": true,
   "slots": {
    "L1": {
     "char": "hero",
     "expr": "neutral"
    },
    "L2": {
     "char": "xiaolong",
     "expr": "neutral"
    },
    "R1": {
     "char": "general_mo",
     "expr": "angry"
    },
    "R2": {
     "char": "fei",
     "expr": "neutral"
    }
   },
   "words": [
    "C1038",
    "C007",
    "C1023",
    "C576"
   ],
   "lines": [
    {
     "id": "l1",
     "speaker": "narrator",
     "side": "none",
     "expr": "neutral",
     "en": "The great doors creak open. General Mo stands before the throne, sword drawn.",
     "vo": null
    },
    {
     "id": "l2",
     "speaker": "general_mo",
     "side": "R1",
     "expr": "angry",
     "en": "Halt. None of you may go in.",
     "zh": "你们不可以进去。",
     "zhTrad": "你們不可以進去。",
     "vo": null
    },
    {
     "id": "l3",
     "speaker": "hero",
     "side": "L1",
     "expr": "angry",
     "en": "We must unite! All of us. Look behind me.",
     "zh": "我们必须团结起来！",
     "zhTrad": "我們必須團結起來！",
     "zhId": "C1038",
     "tokens": [
      "C1038"
     ],
     "vo": null
    },
    {
     "id": "l4",
     "speaker": "narrator",
     "side": "none",
     "expr": "neutral",
     "en": "Behind you stand elves, dwarves, beastfolk and dragons: a friend from every realm.",
     "vo": null
    },
    {
     "id": "l5",
     "speaker": "fei",
     "side": "R2",
     "expr": "happy",
     "en": "We're friends, so we came together.",
     "zh": "我们是朋友，所以我们一起来了。",
     "zhTrad": "我們是朋友，所以我們一起來了。",
     "vo": null
    },
    {
     "id": "l6",
     "speaker": "general_mo",
     "side": "R1",
     "expr": "thinking",
     "en": "Why are you not afraid?",
     "zh": "你们为什么不怕？",
     "zhTrad": "你們為什麼不怕？",
     "vo": null
    },
    {
     "id": "l7",
     "speaker": "xiaolong",
     "side": "L2",
     "expr": "happy",
     "en": "Because we have courage, and we trust our partners.",
     "zh": "因为我们有勇气，而且我们信任伙伴。",
     "zhTrad": "因為我們有勇氣，而且我們信任夥伴。",
     "vo": null
    },
    {
     "id": "l8",
     "speaker": "general_mo",
     "side": "R1",
     "expr": "sad",
     "en": "At the Colosseum you fought fairly. A knight serves his king... but a knight also chooses.",
     "vo": null
    },
    {
     "id": "l9",
     "speaker": "general_mo",
     "side": "R1",
     "expr": "neutral",
     "en": "I surrender. Please, go in.",
     "zh": "我投降。请进。",
     "zhTrad": "我投降。請進。",
     "vo": null,
     "setFlags": [
      "mo_stepped_aside"
     ]
    },
    {
     "id": "l10",
     "speaker": "hero",
     "side": "L1",
     "expr": "thinking",
     "en": "What do you say to General Mo?",
     "vo": null,
     "choices": [
      {
       "id": "c1",
       "en": "{C007}",
       "tokens": [
        "C007"
       ],
       "goto": "l11"
      },
      {
       "id": "c2",
       "en": "{C1023}? Come with us!",
       "tokens": [
        "C1023"
       ],
       "goto": "l11b",
       "setFlags": [
        "asked_mo_partner"
       ]
      }
     ]
    },
    {
     "id": "l11",
     "speaker": "general_mo",
     "side": "R1",
     "expr": "neutral",
     "en": "Go. I will guard this door so that no one runs away. Not even him.",
     "vo": null,
     "goto": "l12"
    },
    {
     "id": "l11b",
     "speaker": "general_mo",
     "side": "R1",
     "expr": "happy",
     "en": "Partner... Hm. Perhaps, after. For now I guard this door.",
     "vo": null
    },
    {
     "id": "l12",
     "speaker": "granny_bai",
     "side": "R1",
     "expr": "happy",
     "en": "One last time, my dears. Are you ready?",
     "zh": "最后一次了。准备好了吗？",
     "zhTrad": "最後一次了。準備好了嗎？",
     "vo": null,
     "swap": {
      "slot": "R1",
      "char": "granny_bai",
      "expr": "happy"
     }
    },
    {
     "id": "l13",
     "speaker": "hero",
     "side": "L1",
     "expr": "angry",
     "en": "{C576}",
     "tokens": [
      "C576"
     ],
     "vo": null
    },
    {
     "id": "l14",
     "speaker": "narrator",
     "side": "none",
     "expr": "neutral",
     "en": "The Harmony Bell hums in your pack. Far above, the Demon King rises from his throne.",
     "vo": null,
     "end": true
    }
   ],
   "onEnd": [
    {
     "setFlag": "final_battle_ready"
    },
    {
     "startBattle": "boss_9"
    }
   ]
  }

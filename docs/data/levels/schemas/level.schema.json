{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "level.schema.json",
 "title": "level/0.2: one map (no realms). Draft by Desy, 2026-10-11 PT, from level-editor.md level/0.1 minus realm/retired/idxMax and (Jack, 2026-10-11) minus elite/scriptedElite and scripted path elites, plus state and settings.words. GameDev leads the final schema. Jack 2026-10-11 (section 9 rulings): no pathFights, no boss-gated links; optional lockedUntilQuest / lockedScene on nodes and edges.",
 "type": "object",
 "required": [
  "schema",
  "id",
  "state",
  "kind",
  "title",
  "entry",
  "settings",
  "nodes",
  "edges",
  "events",
  "quests",
  "scenes"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "level/0.2"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "version": {
   "type": "integer",
   "minimum": 1,
   "description": "set by the server on publish"
  },
  "state": {
   "enum": [
    "draft",
    "beta",
    "golden"
   ],
   "description": "draft: editor only; beta: a published change resets players' progress on this map, and (Jack's decision, 2026-10-11) every quest given on this map goes back to not-started, whatever state it was in; golden: ids and idx frozen, no reset"
  },
  "kind": {
   "enum": [
    "overworld",
    "dungeon_level",
    "town"
   ],
   "description": "No `world` kind (2026-10-11, level-editor.md R4): the world map (`world.json`) is an ordinary overworld map whose nodes are portals."
  },
  "dungeon": {
   "type": [
    "string",
    "null"
   ]
  },
  "level": {
   "type": "integer",
   "minimum": 0,
   "description": "depth: raises the encounter rate by world_rules.depthStep per level below 1"
  },
  "levels": {
   "type": [
    "integer",
    "null"
   ]
  },
  "optional": {
   "type": [
    "boolean",
    "null"
   ]
  },
  "title": {
   "$ref": "#/$defs/txt"
  },
  "entry": {
   "type": "string"
  },
  "aspect": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "settings": {
   "$ref": "#/$defs/settings"
  },
  "nodes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/node"
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/edge"
   }
  },
  "events": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/event"
   }
  },
  "quests": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/quest"
   }
  },
  "scenes": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/scene"
   }
  },
  "characters": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "npcs": {
   "type": "object"
  },
  "assets": {
   "type": "object"
  }
 },
 "$defs": {
  "txt": {
   "type": "object",
   "required": [
    "en"
   ],
   "properties": {
    "en": {
     "type": "string"
    },
    "zh": {
     "type": "string"
    },
    "zhTrad": {
     "type": "string"
    }
   }
  },
  "ref": {
   "type": "object",
   "required": [
    "graph",
    "node"
   ],
   "properties": {
    "graph": {
     "type": "string"
    },
    "node": {
     "type": "string"
    }
   }
  },
  "word": {
   "type": "string",
   "pattern": "^C[0-9]{3,4}$"
  },
  "weighted": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "enemy",
     "weight"
    ],
    "properties": {
     "enemy": {
      "type": "string"
     },
     "weight": {
      "type": "number",
      "exclusiveMinimum": 0
     }
    },
    "additionalProperties": false
   }
  },
  "settings": {
   "type": "object",
   "required": [
    "title",
    "words"
   ],
   "additionalProperties": false,
   "properties": {
    "title": {
     "$ref": "#/$defs/txt"
    },
    "emoji": {
     "type": "string"
    },
    "background": {
     "type": [
      "string",
      "object"
     ]
    },
    "music": {
     "type": "string"
    },
    "desyPool": {
     "type": "string",
     "pattern": "^L[1-9]\\.[1-3]$",
     "description": "provenance only: the curriculum list the words were pre-populated from"
    },
    "words": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/word"
     },
     "uniqueItems": true,
     "description": "the map's own word pool, in review order; Jack edits it"
    },
    "G": {
     "type": "number",
     "exclusiveMinimum": 0,
     "description": "gold unit: prices, rewards and drops on this map"
    },
    "recLevel": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "gearTier": {
     "type": "integer",
     "minimum": 1,
     "description": "chest and battle-drop gear tier, and the recommended-gear check"
    },
    "difficulty": {
     "type": "object",
     "required": [
      "mcOptions",
      "reviewSlots"
     ],
     "additionalProperties": false,
     "properties": {
      "mcOptions": {
       "type": "integer",
       "minimum": 2,
       "maximum": 6
      },
      "reviewSlots": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "enemiesPerBattle": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "roster": {
     "$ref": "#/$defs/weighted"
    },
    "packs": {
     "type": "object",
     "additionalProperties": {
      "type": "integer",
      "minimum": 1
     }
    },
    "encounters": {
     "type": [
      "object",
      "null"
     ]
    },
    "maxHopsToInn": {
     "type": "integer",
     "minimum": 1
    },
    "boss": {
     "type": "object",
     "required": [
      "node",
      "gateEdge",
      "kind",
      "enemy"
     ],
     "additionalProperties": false,
     "properties": {
      "node": {
       "type": "string"
      },
      "gateEdge": {
       "type": "string",
       "description": "the boss node's approach edge (patrol: true, safe). Beating the boss unlocks nothing (Jack 2026-10-11)."
      },
      "kind": {
       "enum": [
        "locboss",
        "realmboss"
       ]
      },
      "enemy": {
       "type": "string"
      },
      "reward": {
       "type": [
        "object",
        "null"
       ],
       "properties": {
        "feather": {
         "type": "integer",
         "minimum": 1,
         "description": "Feathers in the boss chest (LE F4, 2026-10-11): part of the boss reward, never an on:clear node event."
        }
       },
       "description": "What beating the boss gives (skill, heroic item, text, feather). The validator rejects an item-giving on:clear event on the boss node."
      }
     }
    }
   }
  },
  "node": {
   "type": "object",
   "required": [
    "id",
    "idx",
    "kind",
    "x",
    "y"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$"
    },
    "idx": {
     "type": "integer",
     "minimum": 0
    },
    "kind": {
     "type": "string",
     "description": "Node type (town, village, inn, boss, npc, portal, ...). Jack's decision, 2026-10-11: shown in the editor; in game an unvisited node looks like every other unvisited node, and its type and icon show only on arrival (on top of fog of war). No `fog: landmark` field."
    },
    "x": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "y": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "title": {
     "$ref": "#/$defs/txt"
    },
    "save": {
     "type": "boolean"
    },
    "services": {
     "type": "array"
    },
    "hub": {
     "type": [
      "string",
      "null"
     ]
    },
    "town": {
     "type": "integer",
     "description": "shop catalogue id (smith stock, spell shelf)"
    },
    "shops": {
     "type": "array"
    },
    "campfire": {
     "type": "boolean"
    },
    "npc": {
     "type": "string"
    },
    "inBuild": {
     "type": "boolean"
    },
    "quests": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/variant"
     }
    },
    "lockedUntilQuest": {
     "type": "string",
     "pattern": "^q[0-9a-z_]+$",
     "description": "Jack's decision, 2026-10-11 (his one exception to link-only progression): impassable until this quest is completed (turned in). A locked node can't be entered; a locked edge can't be crossed (either way). The quest must exist; its giver, turn-in and every step must be reachable from the start without this lock or any lock whose quest depends on it (validate_levels.py). Nothing else: no keys, no partial progress, no boss gates."
    },
    "lockedScene": {
     "type": "string",
     "pattern": "^sc_[a-z0-9_]+$",
     "description": "Optional scene shown when the player tries to enter or cross while locked (e.g. the workers at the broken bridge). Without it the game shows one default blocked line (combat-spec §12.3)."
    }
   }
  },
  "edge": {
   "type": "object",
   "required": [
    "id",
    "idx",
    "from",
    "to",
    "kind"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "idx": {
     "type": "integer",
     "minimum": 0
    },
    "from": {
     "type": "string"
    },
    "to": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/ref"
      }
     ]
    },
    "kind": {
     "enum": [
      "path",
      "stairs",
      "portal",
      "exit",
      "shortcut",
      "oneway"
     ]
    },
    "danger": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    },
    "steps": {
     "type": "integer",
     "minimum": 1
    },
    "terrain": {
     "type": "string"
    },
    "patrol": {
     "type": "boolean",
     "description": "Marks the boss approach edge (settings.boss.gateEdge): a safe edge, no random battles. Jack 2026-10-11: there are no patrols; only the name is left."
    },
    "cond": {
     "type": "object",
     "description": "Optional link condition (common conditions). Jack 2026-10-11: progression is purely by links, so a link never waits on a boss (validate_levels rejects bossDefeated here); quest locks use lockedUntilQuest."
    },
    "opens": {},
    "label": {},
    "note": {
     "type": "string"
    },
    "lockedUntilQuest": {
     "type": "string",
     "pattern": "^q[0-9a-z_]+$",
     "description": "Jack's decision, 2026-10-11 (his one exception to link-only progression): impassable until this quest is completed (turned in). A locked node can't be entered; a locked edge can't be crossed (either way). The quest must exist; its giver, turn-in and every step must be reachable from the start without this lock or any lock whose quest depends on it (validate_levels.py). Nothing else: no keys, no partial progress, no boss gates."
    },
    "lockedScene": {
     "type": "string",
     "pattern": "^sc_[a-z0-9_]+$",
     "description": "Optional scene shown when the player tries to enter or cross while locked (e.g. the workers at the broken bridge). Without it the game shows one default blocked line (combat-spec §12.3)."
    }
   }
  },
  "event": {
   "type": "object",
   "required": [
    "id",
    "node",
    "on"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "node": {
     "type": "string"
    },
    "on": {
     "enum": [
      "enter",
      "firstEnter",
      "clear",
      "leave",
      "rest",
      "talk"
     ]
    }
   }
  },
  "variant": {
   "type": "object",
   "required": [
    "quest",
    "role"
   ],
   "additionalProperties": false,
   "properties": {
    "quest": {
     "type": "string"
    },
    "role": {
     "enum": [
      "giver",
      "step"
     ]
    },
    "step": {
     "type": [
      "string",
      "null"
     ]
    },
    "pre": {
     "$ref": "#/$defs/vpart"
    },
    "in": {
     "$ref": "#/$defs/vpart"
    },
    "post": {
     "$ref": "#/$defs/vpart"
    }
   }
  },
  "vpart": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "scene": {
     "type": [
      "string",
      "null"
     ]
    },
    "after": {
     "type": [
      "string",
      "null"
     ]
    },
    "events": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/event"
     }
    }
   }
  },
  "quest": {
   "type": "object",
   "required": [
    "schema",
    "id",
    "type",
    "title",
    "giver",
    "objectives",
    "rewards"
   ],
   "not": {
    "anyOf": [
     {
      "required": [
       "realm"
      ]
     },
     {
      "required": [
       "zone"
      ]
     }
    ]
   },
   "properties": {
    "schema": {
     "const": "quest/0.2"
    },
    "id": {
     "type": "string",
     "pattern": "^q[0-9]_[a-z0-9_]+$"
    },
    "giver": {
     "type": "object",
     "required": [
      "graph",
      "node"
     ]
    },
    "objectives": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "objective"
      ],
      "properties": {
       "event": {
        "not": {
         "const": "portal"
        },
        "description": "Step event at `where`. Not `portal` (LE F5): reaching a place is `event: nothing` + `objective: {type: reach}`."
       }
      }
     }
    },
    "scenes": {
     "not": {},
     "description": "Not stored (GameDev LE F5, 2026-10-11): a quest's offer/progress/turn-in scenes are the giver node's variants."
    }
   }
  },
  "scene": {
   "type": "object",
   "required": [
    "schema",
    "id",
    "trigger",
    "lines"
   ],
   "not": {
    "required": [
     "realm"
    ]
   },
   "properties": {
    "schema": {
     "const": "scene/0.2"
    },
    "id": {
     "type": "string",
     "pattern": "^sc_[a-z0-9_]+$"
    },
    "trigger": {
     "type": "object",
     "required": [
      "graph",
      "on"
     ]
    },
    "lines": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "speaker",
       "en"
      ]
     }
    }
   }
  }
 }
}

      "C333"
     ],
     "goto": "l8b"
    }
   ]
  },
  {
   "id": "l8",
   "speaker": "granny_bai",
   "side": "R1",
   "expr": "happy",
   "en": "Go home, little keeper. The village is waiting.",
   "zh": "谢谢大家。",
   "zhTrad": "謝謝大家。",
   "zhId": "C1040",
   "tokens": [
    "C1040"
   ],
   "vo": null,
   "goto": "l9"
  },
  {
   "id": "l8b",
   "speaker": "granny_bai",
   "side": "R1",
   "expr": "happy",
   "en": "Yes. Home first. We will watch the Bell for you.",
   "zh": "我们回家。",
   "zhTrad": "我們回家。",
   "vo": null
  },
  {
   "id": "l9",

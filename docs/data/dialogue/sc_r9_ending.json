 "lines": [
  {
   "id": "l1",
   "speaker": "narrator",
   "side": "none",
   "expr": "neutral",
   "en": "The Demon King falls. His fog crown breaks. He is gone. He does not get up.",
   "vo": null
  },
  {
   "id": "l2",
   "speaker": "granny_bai",
   "side": "R1",
   "expr": "happy",
   "en": "The {C570} Bell! Ring it, all of you!",
   "zh": "和平！",
   "zhTrad": "和平！",
   "zhId": "C570",
   "tokens": [
    "C570"
   ],
   "vo": null
  },
  {
   "id": "l3",
   "speaker": "narrator",
   "side": "none",
   "expr": "neutral",
   "en": "Elves, dwarves, beastfolk, humans and dragons pull the rope together. The Harmony Bell rings out over the nine lands.",
   "vo": null
  },
  {
   "id": "l4",
   "speaker": "xiaolong",
   "side": "L2",
   "expr": "happy",
   "en": "{C1039}!",
   "zh": "我们成功了！",
   "zhTrad": "我們成功了！",
   "zhId": "C1039",
   "tokens": [
    "C1039"
   ],
   "vo": null
  },
  {
   "id": "l5",
   "speaker": "narrator",
   "side": "none",
   "expr": "neutral",
   "en": "The Silent Fog lifts. {C1034} fills the hall. Far below, at Lantern Light Camp, Pipi stands very still and does not run.",
   "tokens": [
    "C1034"
   ],
   "vo": null
  },
  {
   "id": "l6",
   "speaker": "granny_bai",
   "side": "R1",
   "expr": "happy",
   "en": "The Bell needs a keeper. That is you now. You will {C1026} it.",
   "zh": "你保卫和平钟。",
   "zhTrad": "你保衛和平鍾。",
   "tokens": [
    "C1026"
   ],
   "vo": null
  },
  {
   "id": "l7",
   "speaker": "hero",
   "side": "L1",
   "expr": "thinking",
   "en": "What do you say?",
   "vo": null,
   "choices": [
    {
     "id": "c1",

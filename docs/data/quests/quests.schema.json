{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "quest/0.2 (GameDev quest/0.1 + Desy fields)",
 "type": "object",
 "required": [
  "version",
  "schema",
  "quests"
 ],
 "properties": {
  "version": {
   "type": "string"
  },
  "schema": {
   "const": "quest/0.2"
  },
  "quests": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/quest"
   }
  }
 },
 "$defs": {
  "quest": {
   "type": "object",
   "required": [
    "schema",
    "id",
    "realm",
    "zone",
    "story",
    "type",
    "title",
    "giver",
    "turnIn",
    "order",
    "objectives",
    "scenes",
    "rewards",
    "words",
    "repeatable"
   ],
   "properties": {
    "schema": {
     "const": "quest/0.2"
    },
    "id": {
     "type": "string",
     "pattern": "^q[1-9]_[a-z0-9_]+$"
    },
    "realm": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9
    },
    "zone": {
     "type": "string"
    },
    "pool": {
     "type": "string"
    },
    "story": {
     "enum": [
      "main",
      "side"
     ]
    },
    "type": {
     "enum": [
      "fetch",
      "slay",
      "rescue",
      "find",
      "deliver",
      "escort"
     ]
    },
    "title": {
     "type": "object",
     "required": [
      "zh",
      "en"
     ]
    },
    "giver": {
     "type": "object",
     "required": [
      "npc"
     ],
     "properties": {
      "npc": {
       "type": "string"
      },
      "graph": {
       "type": "string"
      },
      "node": {
       "type": "string"
      },
      "zone": {
       "type": "string"
      },
      "nodeKind": {
       "type": "string"
      },
      "position": {
       "type": "string"
      },
      "ref": {
       "type": "string"
      }
     }
    },
    "alsoOnBoard": {
     "type": "boolean"
    },
    "turnIn": {
     "oneOf": [
      {
       "enum": [
        "giver",
        "auto"
       ]
      },
      {
       "type": "object",
       "required": [
        "npc"
       ]
      }
     ]
    },
    "returnToGiver": {
     "type": "boolean"
    },
    "requires": {
     "type": [
      "object",
      "null"
     ]
    },
    "order": {
     "enum": [
      "any",
      "sequence"
     ],
     "description": "sequence: only the current objective listens to events; counters start when that objective becomes current."
    },
    "objectives": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "event",
       "objective",
       "where"
      ],
      "properties": {
       "event": {
        "enum": [
         "quest_offer",
         "nothing",
         "miniboss",
         "item",
         "portal",
         "story",
         "treasure",
         "edge_battle",
         "boss"
        ]
       },
       "objective": {
        "type": "object",
        "required": [
         "type"
        ],
        "properties": {
         "type": {
          "enum": [
           "kill",
           "collect",
           "reach",
           "talk",
           "words",
           "deliver",
           "escort"
          ]
         }
        },
        "allOf": [
         {
          "if": {
           "properties": {
            "type": {
             "const": "escort"
            }
           }
          },
          "then": {
           "required": [
            "npc",
            "to"
           ],
           "properties": {
            "npc": {
             "type": "string"
            },
            "to": {
             "type": "object",
             "required": [
              "zone",
              "nodeKind"
             ],
             "description": "Target node: ref '<graph>/<node>', or zone + town/village position."
            }
           }
          },
          "description": "ESCORT (runtime): when this step becomes current, `npc` follows the party on the map. It is not in battles and cannot be harmed, so it never fails. The step completes when the party enters the `to` node. The escortee always stays with the party: after a defeat it is waiting at the last inn used, where the party wakes up, and Return Feather or inn warp take it along. Save: obj.<stepId> = 0 until done, then 1; the follower is derived from the current step (nothing else stored). Dropping the quest sends the escortee back to the giver."
         },
         {
          "if": {
           "properties": {
            "type": {
             "const": "words"
            }
           }
          },
          "then": {
           "required": [
            "pool"
           ],
           "properties": {
            "pool": {
             "type": "string",
             "pattern": "^L[1-9]\\.[1-3]$"
            },
            "n": {
             "type": "integer",
             "minimum": 1,
             "default": 10
            }
           }
          },
          "description": "WORDS (runtime): while this step is current, every correct battle answer to an item in `pool` adds 1 (any answer way; repeats of the same word count; practice and Preview do not). The step completes at `n` (default 10). Save: obj.<stepId> = count. No base list needed."
         }
        ]
       }
      }
     }
    },
    "scenes": {
     "type": "object"
    },
    "rewards": {
     "type": "object",
     "required": [
      "gold",
      "exp",
      "items",
      "gear",
      "spells",
      "skills"
     ]
    },
    "words": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^C[0-9]{3,4}$"
     }
    },
    "repeatable": {
     "const": false
    }
   }
  }
 }
}
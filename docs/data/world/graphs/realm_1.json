 "dialogue": {
  "meadow_intro": [
   {
    "speaker": "panda",
    "zh": "这里是新手草原！",
    "en": "This is Starter Meadow! Tap a place to walk there. Monsters hide in the long grass."
   }
  ],
  "ambient": [
   {
    "speaker": "panda",
    "zh": "我们走吧！",
    "en": "Let's keep going!"
   }
  ],
  "farmer_thanks": [
   {
    "speaker": "farmer_li",
    "zh": "谢谢你！",
    "en": "Thank you, little hero!"
   }
  ],
  "well_hint": [
   {
    "speaker": "panda",
    "zh": "井里有东西在发光。",
    "en": "Something shiny is down in the old well... Farmer Li lost something!"
   }
  ],
  "crow_boss_intro": [
   {
    "speaker": "panda",
    "zh": "大嘴乌鸦！",
    "en": "The Big-Beak Crow guards the hill road!"
   }
  ],
  "clover_sign": [
   {
    "speaker": "panda",
    "zh": "一、二、三……",
    "en": "The old sign counts the hills: 一, 二, 三!"
   }
  ],
  "camp_welcome": [
   {
    "speaker": "panda",
    "zh": "营火真暖和。",
    "en": "A campfire inn! We can rest and save here."
   }
  ],
  "thief_gone": [
   {
    "speaker": "panda",
    "zh": "小偷跑了。",
    "en": "The carrot thief's nest is empty now."
   }
  ],
  "king_warning": [
   {
    "speaker": "panda",
    "zh": "角兔王就在前面！",
    "en": "The Horned Rabbit King is just ahead! Rest here first."
   }
  ],
  "king_beaten": [
   {
    "speaker": "panda",
    "zh": "你赢了！",
    "en": "You did it! The road to Honeycomb Forest is open."
   }
  ]
 },

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://zenjax7.github.io/chinese-rpg/schemas/world/world_rules.schema.json",
 "title": "Encounter and travel knobs (may merge into balance.json as 'world')",
 "type": "object",
 "properties": {
  "_note": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "encounterRate": {
   "type": "object",
   "patternProperties": {
    "^[0-3]$": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "required": [
    "0",
    "1",
    "2",
    "3"
   ],
   "additionalProperties": false
  },
  "depthStep": {
   "type": "number",
   "minimum": 0
  },
  "maxRate": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "safe": {
   "type": "object"
  },
  "clearedStepMult": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "zoneBattleBudget": {
   "type": "integer",
   "minimum": 1
  },
  "budgetSpentMult": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "pityRolls": {
   "type": "integer",
   "minimum": 0
  },
  "repel": {
   "type": "object",
   "properties": {
    "item": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$"
    },
    "hops": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "item",
    "hops"
   ]
  },
  "walkSecPerHop": {
   "type": "number"
  },
  "walkSecPerStep": {
   "type": "number"
  },
  "eventSec": {
   "type": "object"
  },
  "beelineBattleTarget": {
   "type": "number"
  },
  "beelineBattleRange": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "maxHopsToInn": {
   "oneOf": [
    {
     "type": "integer",
     "minimum": 1
    },
    {
     "type": "object",
     "properties": {
      "default": {
       "type": "integer",
       "minimum": 1
      }
     },
     "patternProperties": {
      "^[1-9]$": {
       "type": "integer",
       "minimum": 1
      }
     },
     "required": [
      "default"
     ],
     "additionalProperties": false
    }
   ]
  },
  "townDensity": {
   "type": "object"
  },
  "fog": {
   "type": "object"
  },
  "realmBossFeather": {
   "type": "object",
   "properties": {
    "realms": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
     }
    },
    "qty": {
     "type": "integer",
     "minimum": 1
    },
    "note": {
     "type": "string"
    }
   },
   "required": [
    "realms"
   ],
   "additionalProperties": false
  },
  "returnFeather": {
   "type": "object",
   "properties": {
    "item": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$"
    },
    "priceG": {
     "type": "number",
     "minimum": 0
    },
    "carry": {
     "type": "integer"
    },
    "start": {
     "type": "integer",
     "minimum": 0
    },
    "useSec": {
     "type": "number"
    },
    "destinations": {
     "type": "array",
     "items": {
      "enum": [
       "lastInn",
       "visitedTown"
      ]
     },
     "description": "lastInn = the single node where the player last rested; visitedTown = every town or village node ever entered. Other visited inns are not destinations."
    },
    "destinationRule": {
     "type": "string"
    },
    "usable": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   },
   "required": [
    "item",
    "priceG",
    "carry",
    "start",
    "destinations"
   ],
   "additionalProperties": false
  },
  "seed": {
   "type": "object",
   "properties": {
    "algorithm": {
     "const": "mulberry32"
    },
    "hash": {
     "const": "fnv1a32"
    },
    "key": {
     "type": "string"
    },
    "eventKey": {
     "type": "string"
    },
    "hashRule": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "testVectors": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "key": {
        "type": "string"
       },
       "fnv1a32": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
       },
       "roll": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       }
      },
      "required": [
       "key",
       "fnv1a32",
       "roll"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "algorithm",
    "hash",
    "key",
    "testVectors"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "encounterRate",
  "depthStep",
  "maxRate",
  "safe",
  "clearedStepMult",
  "zoneBattleBudget",
  "budgetSpentMult",
  "pityRolls",
  "maxHopsToInn",
  "returnFeather"
 ],
 "additionalProperties": false
}
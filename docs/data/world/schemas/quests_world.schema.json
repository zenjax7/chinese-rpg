{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://zenjax7.github.io/chinese-rpg/schemas/world/quests_world.schema.json",
 "title": "NPC quest hooks and quest items placed on the world graphs",
 "type": "object",
 "properties": {
  "_note": {
   "type": "string"
  },
  "version": {
   "type": "string"
  },
  "questHooks": {
   "type": "array",
   "items": {
    "type": "object",
    "description": "v3.9: an NPC slot on the graphs. status quest = used by data/quests.json (quest/0.2; quest content lives there); ambient = free slot, a repeatable one-line banter NPC.",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "status": {
      "enum": [
       "quest",
       "ambient"
      ]
     },
     "giver": {
      "type": "string",
      "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"
     },
     "turnIn": {
      "type": "string"
     },
     "quests": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9_]+$"
      },
      "description": "data/quests.json ids that use this node (giver or step)"
     },
     "offers": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9_]+$"
      },
      "description": "quests offered here (offerQuest in the node's events)"
     },
     "banter": {
      "type": "string",
      "description": "ambient: dialogue/event id of the banter line"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "status",
     "giver",
     "quests"
    ],
    "additionalProperties": false
   }
  },
  "questItems": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "zh": {
      "type": "string"
     },
     "en": {
      "type": "string"
     },
     "emoji": {
      "type": "string"
     },
     "quest": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     }
    },
    "required": [
     "id",
     "en",
     "quest"
    ],
    "additionalProperties": false
   }
  },
  "speakers": {
   "type": "object"
  }
 },
 "required": [
  "questHooks",
  "questItems"
 ],
 "additionalProperties": false
}
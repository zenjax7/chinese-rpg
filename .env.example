# Names only (architecture.md §14.1). Never commit values: real values live in Vercel env (Sensitive) and, for migrations,
# a GitHub Actions secret. Copy to .env.local for local work; .env* files other than this one are git-ignored.

# Auth.js (Google sign-in, database sessions)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres (set by the Vercel Neon integration): pooled for the Functions, unpooled for migrations only
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# HMAC keys and salts
PIN_PEPPER=
IP_HASH_KEY=
AUDIT_HASH_SALT=

# Vercel Cron bearer token for GET /api/v1/cron/daily
CRON_SECRET=

# Optional: the app origin(s) allowed by the CSRF check, comma-separated (default: the request's own host)
APP_ORIGIN=

# Local tests only: a real Postgres for npm run test:api:pg (default: PGlite in-process)
TEST_DATABASE_URL=

# Build flag, not a key: 1 turns on cloud saving in the client (off by default; GitHub Pages never sets it)
VITE_CLOUD_SAVE=

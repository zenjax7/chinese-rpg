{
  "name": "chinese-rpg",
  "version": "1.0.0",
  "description": "Chinese-learning RPG prototype (Phaser 4 + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "prebuild": "sh tools/sync_sprites.sh && sh tools/sync_assets.sh && python3 tools/world/build_world.py && python3 tools/editor/build_wordbank.py && python3 tools/editor/level_hashes.py && node tools/editor/build_schema_check.mjs",
    "predev": "sh tools/sync_sprites.sh && sh tools/sync_assets.sh",
    "test": "node tests/play.mjs",
    "build:ci": "tsc && vite build",
    "build:cloud": "tsc && VITE_CLOUD_SAVE=1 vite build --outDir dist-cloud",
    "world": "python3 tools/world/build_world.py",
    "validate:world": "python3 tools/world/validate_all.py",
    "test:world": "node tests/world.mjs",
    "test:account": "node tests/account.mjs",
    "test:editor": "node tests/editor.mjs",
    "test:api": "node tools/check_esm_imports.mjs && tsc -p tsconfig.server.json && vitest run -c vitest.api.config.ts",
    "test:api:pg": "node -e \"if(!process.env.TEST_DATABASE_URL){console.error('Set TEST_DATABASE_URL to a throwaway local Postgres database');process.exit(1)}\" && vitest run -c vitest.api.config.ts",
    "check:esm": "node tools/check_esm_imports.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:status": "node server/migrate.mjs --status",
    "check:dist": "node tools/check_dist.mjs dist",
    "db:seed-levels": "node server/seed-levels.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/neon-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.2.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "fast-deep-equal": "^3.1.3",
    "phaser": "^4.2.1",
    "pinyin-pro": "^3.29.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
